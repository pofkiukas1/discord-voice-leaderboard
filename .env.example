# Copy to .env and fill these values on the Oracle VM. NEVER commit the real token.
DISCORD_BOT_TOKEN=replace_with_discord_bot_token
DISCORD_GUILD_ID=replace_with_server_id
# Optional initial channel ID. Prefer /leaderboard-channel in Discord.
# DISCORD_CHANNEL_ID=
# Optional: defaults to ./data/voice.sqlite
# DB_PATH=./data/voice.sqlite

[Unit]
Description=Discord Voice Activity Leaderboard Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/discord-voice-leaderboard
EnvironmentFile=/home/ubuntu/discord-voice-leaderboard/.env
ExecStart=/usr/bin/node /home/ubuntu/discord-voice-leaderboard/src/index.js
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
